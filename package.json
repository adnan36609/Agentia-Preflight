{
  "name": "agentia-cli-agentia-preflight",
  "description": "Evidence-based release readiness checks for Agentia workflows",
  "version": "0.1.0",
  "author": "MOHD ADNAN",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "oclif-plugin",
    "agentia"
  ],
  "files": [
    "/dist",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@copado/agentia-plugin-sdk": "^0.1.2",
    "@oclif/core": "^4",
    "execa": "^10.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "oclif": "^4",
    "shx": "^0.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "agentia": {
    "hostApi": 1,
    "requires": [
      "auth.status",
      "workspace.current",
      "job.list",
      "job.get",
      "pipeline.list",
      "promotion.list"
    ],
    "permissions": {
      "network": [],
      "files": "repository",
      "commands": [
        "git",
        "npm"
      ],
      "env": [
        "COMSPEC",
        "GIT_CONFIG_GLOBAL",
        "GIT_CONFIG_NOSYSTEM",
        "GIT_CONFIG_SYSTEM",
        "GIT_EXEC_PATH",
        "HOME",
        "HOMEDRIVE",
        "HOMEPATH",
        "LANG",
        "LC_*",
        "PATH",
        "SYSTEMROOT",
        "TEMP",
        "TMP",
        "TMPDIR",
        "USERPROFILE",
        "WINDIR",
        "XDG_*"
      ]
    },
    "hooks": []
  },
  "oclif": {
    "bin": "agentia",
    "dirname": "agentia-cli",
    "commands": "./dist/commands",
    "topics": {
      "preflight": {
        "description": "Preflight plugin commands"
      }
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "clean": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest",
    "postpack": "npm run clean",
    "test": "vitest run"
  }
}